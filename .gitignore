# ---- data: contents never committed, directory skeleton kept --------------
# NOTE: we ignore the CONTENTS (data/**) rather than the directory (data/),
# because git will not descend into an ignored directory, which would make
# the !.gitkeep negations below unreachable.
data/**
!data/**/
!data/**/.gitkeep

# ---- model checkpoints & heavy outputs ------------------------------------
outputs/checkpoints/**
outputs/predictions/**
outputs/logs/**
outputs/figures/**
!outputs/**/
!outputs/**/.gitkeep

# outputs/tables/ (the DDM CSVs) IS tracked - small, and they are results.

*.ckpt
*.pt
*.pth
*.safetensors
lightning_logs/
wandb/
runs/
mlruns/

# ---- geo / raster scratch -------------------------------------------------
*.tif
*.tiff
*.img
*.jp2
*.hdf
*.nc
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.zip

# ---- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- tooling --------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---- secrets --------------------------------------------------------------
.env
*.key
credentials.json
.config/earthengine/

# ---- os / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
